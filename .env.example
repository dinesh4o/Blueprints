# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/Blueprints26DB

# Session Secret (REQUIRED — generate with: openssl rand -base64 32)
SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# Client URL
CLIENT_URL=http://localhost:5173

# Google OAuth (Required for Google Sign-in)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Groq API (For AI synthesis via LangGraph pipeline)
GROQ_API_KEY=your-groq-api-key

# Anthropic API (For Claude Ask AI chat feature)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Gemini API (For client-side AI in ProgressPage)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Vite public keys (must be prefixed VITE_ to be exposed to frontend)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key
